#350. Intersection of Two Arrays II
class Solution:
    def intersect(self, nums1: list[int], nums2: list[int]) -> list[int]:
        new_list = []
        new_list2 = []
        nums1_copy = list(nums1)
        nums2_copy = list(nums2)
        for i in nums1:
            if i in nums2_copy: 
                new_list.append(i)
                nums2_copy.remove(i) 
        for i in nums2:
            if i in nums1_copy: 
                new_list2.append(i)
                nums1_copy.remove(i)      
        nums1[:] = new_list
        nums2[:] = new_list2
        if len(nums1) >= len(nums2):
            return nums2
        else:
            return nums1


