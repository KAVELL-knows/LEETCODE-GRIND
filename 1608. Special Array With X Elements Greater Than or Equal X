class Solution:
    def specialArray(self, nums: list[int]) -> int:
        
        for i in range(1, len(nums)+1):
            status = False
            count = 0 

            for j in nums:
                if j >= i:
                    count += 1 
            if count == i:
                status = True
                break

        if status:
            return i
        else:
            return -1
