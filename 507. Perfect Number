class Solution:
    def checkPerfectNumber(self, num: int) -> bool:
        i = 1
        factors = []
        while i <= (num ** 0.5):
            if num % i == 0:
                factors.append(i)
                factors.append(num // i)
            i += 1

        total = sum(factors) - num

        if total == num and total != 1:
            return True
        else:
            return False
