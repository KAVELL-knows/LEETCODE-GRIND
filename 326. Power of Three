class Solution:
    def isPowerOfThree(self, n: int) -> bool:
        x = 1 
        count  = 0 
        if n % 2 == 0:
            return False
        elif n % 5 == 0:
            return False
        elif n == 0:
            return False
        elif n == 1:
            return True
        else:
            if n > 0:
                while True:
                    x = x * 3 
                    if x > n:
                        return False
                        break
                    elif x == n:
                        return True
                        break
            else:
                return False
