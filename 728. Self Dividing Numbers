class Solution:
    def selfDividingNumbers(self, left: int, right: int) -> list[int]:
        answer = []

        for i in range(left, right + 1):
            count = 0
            for num in str(i):
                if int(num) == 0:
                    break
                elif i % int(num) == 0:
                    count += 1
            if count == len(str(i)):
                answer.append(i)

        return answer
