class Solution:
    def getCommon(self, nums1: list[int], nums2: list[int]) -> int:
        if nums1[0] > nums2[-1] or nums2[0] > nums1[-1]:
            return -1
        i = 0
        j = 0

        while i < len(nums1) and j < len(nums2):
            if nums1[i] < nums2[j]:
                i += 1
            elif nums1[i] > nums2[j]:
                j += 1   
            elif nums1[i] == nums2[j]:
                return nums1[i]
        return -1
