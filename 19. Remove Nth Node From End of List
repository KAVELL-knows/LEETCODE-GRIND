class Solution:
    def removeNthFromEnd(self, head: ListNode | None, n: int) -> ListNode | None:
        dummy = ListNode(0, head)
        count = 0
        current = head
        while current:
            count += 1
            current = current.next
            
        current = dummy
        for _ in range(count - n):
            current = current.next

        current.next = current.next.next        
        return dummy.next
