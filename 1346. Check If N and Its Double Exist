class Solution:
    def checkIfExist(self, arr: list[int]) -> bool:
        count = 0

        for i in range(len(arr)):
            for j in range(len(arr)):
                if arr[i] == 2 * arr[j] and i != j:
                    count = 1
                    break

        if count != 0:
            return True
        else:
            return False
