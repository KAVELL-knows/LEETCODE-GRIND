class Solution:
    def addDigits(self, num: int) -> int:
        p = 0
        while p >= 10 or p == 0:
            p = 0     
            while num > 0: 
                y = num % 10 
                num = num // 10
                p += y
            if p < 10:
                return p 
            else:
                num = p
