class Solution:
    def singleNumber(self, nums: List[int]) -> int:
        nums.sort()
        unique = []
        if len(nums) == 1:
            return nums[0] 
        else:
            for i in range(0, len(nums)-1 , 2):
                if nums[i] != nums[i+1]:
                    unique.append(nums[i])
                    return unique[0] 
                    break
            return nums[-1]
