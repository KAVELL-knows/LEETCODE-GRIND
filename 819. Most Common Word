class Solution:
    def mostCommonWord(self, paragraph: str, banned: list[str]) -> str:
        paragraph = paragraph.lower()
        banned = [word.lower() for word in banned]

        for symbol in "!?',;.":
            paragraph = paragraph.replace(symbol, " ")
        words = paragraph.split()

        most = 0 
        word = ""

        for i in words:           
            if i not in banned:
                y = words.count(i) 
                if y > most:
                    most = y
                    word = i
                    
        return word
