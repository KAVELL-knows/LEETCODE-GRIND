class Solution:

  def kWeakestRows(self, mat: List[List[int]], k: int) -> List[int]:
    order = []

    for i, row in enumerate(mat):
      total = sum(row)
      order.append((total, i))

    order.sort()

    result = []
    for pair in order[:k]:
      result.append(pair[1])

    return result
