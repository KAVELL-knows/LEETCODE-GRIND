class Solution:
    def getIntersectionNode(self, headA: ListNode, headB: ListNode) -> Optional[ListNode]:
        if not headA or not headB:
            return None

        pA = headA
        pB = headB

        while pA is not pB:
            if pA is not None:
                pA = pA.next
            else:
                pA = headB

            if pB is not None:
                pB = pB.next
            else:
                pB = headA

        return pA
