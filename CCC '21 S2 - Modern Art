input_data = open(0).read().split()

m = int(input_data[0])
n = int(input_data[1])
k = int(input_data[2])

row_counts = [0] * (m + 1)
col_counts = [0] * (n + 1)

idx = 3
for i in range(k):
    direction = input_data[idx]
    index = int(input_data[idx + 1])
    
    if direction == 'R':
        row_counts[index] += 1 
    else:
        col_counts[index] += 1  
        
    idx += 2
    
r_odd = 0
for count in row_counts:
    if count % 2 != 0:
        r_odd += 1

c_odd = 0
for count in col_counts:
    if count % 2 != 0:
        c_odd += 1

ans = (r_odd * (n - c_odd)) + ((m - r_odd) * c_odd)

print(ans)
