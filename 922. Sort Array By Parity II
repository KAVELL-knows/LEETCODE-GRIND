class Solution:
    def sortArrayByParityII(self, nums: list[int]) -> list[int]:
        answer = [0] * len(nums)

        even = 0
        odd = 1

        for i in range(len(nums)):
            if nums[i] % 2 == 0:
                answer[even] = nums[i]
                even += 2  
            else:
                answer[odd] = nums[i]
                odd += 2 
