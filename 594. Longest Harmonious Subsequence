from collections import Counter 
class Solution:
    def findLHS(self, nums: list[int]) -> int:
        s = nums
        y = len(set(s))
        if y == 1:
            return 0
        counts = Counter(s)
        max_length = 0
        for i in counts:
            if i + 1 in counts:
                current_length = counts[i] + counts[i + 1]
                max_length = max(max_length, current_length)
                
        return max_length

        
